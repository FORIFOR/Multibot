[
  {
    "logical_path": "readiness.json",
    "json_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "production_ready",
        "deployment",
        "summary",
        "areas"
      ],
      "$defs": {
        "row": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "area",
            "implemented",
            "remaining",
            "source_file",
            "evidence_quote"
          ],
          "properties": {
            "area": {
              "type": "string"
            },
            "implemented": {
              "type": "string",
              "description": "Japanese summary required. Do not copy the English source quotation.",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "[ぁ-んァ-ン一-龯]"
            },
            "remaining": {
              "type": "string",
              "description": "Japanese summary required. Do not copy the English source quotation.",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "[ぁ-んァ-ン一-龯]"
            },
            "source_file": {
              "const": "PRODUCTION_PLAN.md"
            },
            "evidence_quote": {
              "type": "string",
              "description": "Exact English source quotation; do not translate or alter."
            }
          }
        }
      },
      "properties": {
        "product": {
          "const": "Multibot"
        },
        "production_ready": {
          "const": false
        },
        "deployment": {
          "const": "dedicated-single-host"
        },
        "summary": {
          "type": "string",
          "description": "Japanese summary required. Do not copy the English source quotation.",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "[ぁ-んァ-ン一-龯]"
        },
        "areas": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/row"
                },
                {
                  "properties": {
                    "area": {
                      "const": "Identity"
                    },
                    "evidence_quote": {
                      "const": "Production IdP configuration, organization identity policy, MFA enforcement and account lifecycle acceptance"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/row"
                },
                {
                  "properties": {
                    "area": {
                      "const": "Isolation"
                    },
                    "evidence_quote": {
                      "const": "Independent attack review, customer-specific role/connector/egress policy, permission lifecycle acceptance"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/row"
                },
                {
                  "properties": {
                    "area": {
                      "const": "Execution"
                    },
                    "evidence_quote": {
                      "const": "Workload/load acceptance, external-action retry policy, approved availability topology; no distributed workers/HA"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/row"
                },
                {
                  "properties": {
                    "area": {
                      "const": "Data"
                    },
                    "evidence_quote": {
                      "const": "Approved retention policy including historical backups/forks/provider copies, host encryption and recovery-key custody, off-site recovery drill, agreed RPO/RTO"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/row"
                },
                {
                  "properties": {
                    "area": {
                      "const": "Audit / monitoring"
                    },
                    "evidence_quote": {
                      "const": "Independent retained/WORM custody, actual alert delivery and escalation, collector supervision deployment, service objectives and incident acceptance"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/row"
                },
                {
                  "properties": {
                    "area": {
                      "const": "Deployment"
                    },
                    "evidence_quote": {
                      "const": "Real TLS/DNS environment, identity service, operating owner, target-environment upgrade/rollback and security review"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/row"
                },
                {
                  "properties": {
                    "area": {
                      "const": "Business quality"
                    },
                    "evidence_quote": {
                      "const": "Ten repeated actual-source runs, source/summary correctness, review miss/false-positive evaluation, latency and acceptance thresholds"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/row"
                },
                {
                  "properties": {
                    "area": {
                      "const": "Contract / operation"
                    },
                    "evidence_quote": {
                      "const": "Owner-approved service scope, SLO/SLA, support and incident responsibility; no invented approvals or certifications"
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    }
  }
]
