:root {
  --bg: #f7f8fa;
  --fg: #1d2230;
  --muted: #5a6478;
  --line: #d9dee8;
  --accent: #2f5bd7;
  --card: #ffffff;
}

* {
  box-sizing: border-box;
}

html {
  font-size: 16px;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font-family: "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, sans-serif;
  line-height: 1.8;
}

.wrap {
  max-width: 46rem;
  margin: 0 auto;
  padding: 0 1.25rem;
}

.site-header {
  background: var(--card);
  border-bottom: 1px solid var(--line);
}

.site-title {
  font-size: 1.05rem;
  font-weight: 700;
  margin: 0;
  padding: 1rem 0 0.25rem;
}

.nav ul {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin: 0;
  padding: 0 0 0.9rem;
}

.nav a {
  color: var(--muted);
  text-decoration: none;
  font-size: 0.95rem;
  padding-bottom: 0.15rem;
  border-bottom: 2px solid transparent;
}

.nav a:hover {
  color: var(--accent);
}

.nav a[aria-current="page"] {
  color: var(--accent);
  border-bottom-color: var(--accent);
  font-weight: 700;
}

main {
  padding: 2rem 0 3rem;
}

h1 {
  font-size: 1.75rem;
  line-height: 1.45;
  margin: 0 0 0.75rem;
}

h2 {
  font-size: 1.25rem;
  margin: 2.25rem 0 0.75rem;
  padding-bottom: 0.35rem;
  border-bottom: 1px solid var(--line);
}

h3 {
  font-size: 1.05rem;
  margin: 1.5rem 0 0.5rem;
}

p {
  margin: 0.75rem 0;
}

a {
  color: var(--accent);
}

.lead {
  font-size: 1.05rem;
  color: var(--muted);
}

.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 1rem 1.25rem;
  margin: 1rem 0;
}

.note {
  border-left: 4px solid var(--accent);
  background: var(--card);
  padding: 0.75rem 1rem;
  margin: 1.25rem 0;
}

ol,
ul {
  padding-left: 1.4rem;
}

ol li,
ul li {
  margin: 0.4rem 0;
}

dl {
  margin: 0;
}

dt {
  font-weight: 700;
  margin-top: 1.25rem;
}

dd {
  margin: 0.35rem 0 0;
  color: var(--fg);
}

table {
  border-collapse: collapse;
  width: 100%;
  margin: 1rem 0;
}

th,
td {
  border: 1px solid var(--line);
  padding: 0.5rem 0.75rem;
  text-align: left;
  font-size: 0.95rem;
  background: var(--card);
}

th {
  color: var(--muted);
  font-weight: 700;
}

code {
  background: #eceff5;
  border-radius: 4px;
  padding: 0.1rem 0.35rem;
  font-size: 0.9em;
}

.next-steps {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin: 1.25rem 0;
  padding: 0;
  list-style: none;
}

.next-steps a {
  display: inline-block;
  border: 1px solid var(--accent);
  border-radius: 6px;
  padding: 0.5rem 1rem;
  text-decoration: none;
}

.site-footer {
  border-top: 1px solid var(--line);
  background: var(--card);
  color: var(--muted);
  font-size: 0.9rem;
  padding: 1.25rem 0;
}

@media (max-width: 480px) {
  h1 {
    font-size: 1.5rem;
  }
}
