{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "input_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "artifact_id",
                "revision",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "output_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "check_kind": {
                  "enum": [
                    "programmatic",
                    "source_check",
                    "human_review",
                    "model_review"
                  ]
                }
              },
              "required": [
                "id",
                "description",
                "check_kind"
              ],
              "additionalProperties": false
            }
          },
          "write_scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "owner",
          "objective",
          "depends_on",
          "input_artifacts",
          "output_paths",
          "acceptance",
          "write_scope"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "goal",
    "assumptions",
    "agents",
    "tasks"
  ],
  "additionalProperties": false
}
