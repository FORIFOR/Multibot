{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_kind": {
      "enum": [
        "runtime",
        "agent",
        "human"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "enum": [
        "run.started",
        "task.started",
        "task.blocked",
        "message.sent",
        "artifact.published",
        "check.completed",
        "approval.requested",
        "run.completed",
        "run.failed",
        "run.cancelled",
        "config.resolved"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "seq",
    "recorded_at",
    "actor_id",
    "actor_kind",
    "task_id",
    "causation_id",
    "type",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.sent"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "from_agent_id": {
                "type": "string",
                "minLength": 1
              },
              "to_agent_id": {
                "type": "string",
                "minLength": 1
              },
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "enum": [
                  "request",
                  "question",
                  "answer",
                  "handoff",
                  "finding",
                  "decision"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "artifact_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "artifact_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "artifact_id",
                    "revision",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "reply_to": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "from_agent_id",
              "to_agent_id",
              "task_id",
              "purpose",
              "text",
              "artifact_refs",
              "reply_to"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
