{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:router": "node --test tests/router.test.mjs",
    "test:bots": "node --experimental-strip-types --test tests/bot-presentation.test.mjs",
    "test:ui": "npm run build && node scripts/ui-polish-smoke.mjs",
    "test:journey": "node --experimental-strip-types --test tests/journey.test.mjs",
    "test:welcome": "node --experimental-strip-types --test tests/welcome.test.mjs",
    "test:markdown": "node --experimental-strip-types --test tests/markdown.test.mjs",
    "test:polish": "node scripts/ui-polish-smoke.mjs",
    "test:flow": "node scripts/three-step-smoke.mjs",
    "test:a11y": "node scripts/a11y-smoke.mjs",
    "test:delivery": "node --experimental-strip-types --test tests/text-delivery.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
